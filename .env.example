# Required Discord application settings
DISCORD_TOKEN=put_your_bot_token_here
CLIENT_ID=put_your_application_id_here

# Optional: bot owner Discord user IDs, comma-separated
OWNER_IDS=

# Lavalink music settings (optional).
# LAVALINK_NODES accepts a JSON array and overrides all other node sources.
# Otherwise LAVALINK_HOST overrides lavalink/nodes.json when it is set.
LAVALINK_NODES=
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_NAME=Main
LAVALINK_SEARCH_PLATFORM=ytmsearch
LAVALINK_REST_VERSION=v4
# Set true for detailed Riffy connection diagnostics (voice tokens are redacted).
MUSIC_DEBUG=false

# Optional settings (defaults work on most hosts)
BOT_DATA_DIR=./data
PORT=3000
LOG_LEVEL=info
TMDB_API_KEY=
